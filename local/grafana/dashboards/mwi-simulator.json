{
  "uid": "mwi-simulator",
  "title": "MWI simulator performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "mwi"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sim hours / s",
      "datasource": {
        "type": "prometheus",
        "uid": "mwi-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "rate(mwi_sim_simulated_seconds_total[$__rate_interval]) / 3600"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Simulations / s",
      "datasource": {
        "type": "prometheus",
        "uid": "mwi-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "sum(rate(mwi_sim_jobs_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cores in kernel",
      "datasource": {
        "type": "prometheus",
        "uid": "mwi-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "rate(mwi_sim_kernel_seconds_total[$__rate_interval])"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker utilization",
      "datasource": {
        "type": "prometheus",
