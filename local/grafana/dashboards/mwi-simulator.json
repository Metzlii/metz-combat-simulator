        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "rate(mwi_sim_simulated_seconds_total[$__rate_interval]) / 3600",
          "legendFormat": "sim hours / s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "sum(rate(mwi_sim_jobs_total[$__rate_interval]))",
          "legendFormat": "sims / s"
        }
      ]
    },
    {
