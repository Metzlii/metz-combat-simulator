      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mwi-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mwi_sim_kernel_ms_per_simulated_hour_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 6,
